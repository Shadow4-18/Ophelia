# ~/.ophelia/.env — The Ophelia Project

# --- Provider routing (local-first default) ---
# Values: auto | ollama | xai-oauth | xai | deepseek | openai | compat
OPHELIA_PROVIDER=ollama

# Optional per-role provider overrides (each role can use a different provider)
# OPHELIA_PROVIDER_CHAT=ollama
# OPHELIA_PROVIDER_CONSCIOUSNESS=ollama
# OPHELIA_PROVIDER_VISION=ollama
# OPHELIA_PROVIDER_CURATOR=ollama
# OPHELIA_PROVIDER_IMAGE=xai-oauth
# OPHELIA_PROVIDER_VIDEO=xai-oauth
# OPHELIA_AUTO_LOCAL_CONSCIOUSNESS=true

# Fallback: if the primary provider fails (rate limit, 5xx, network), retry
# on these providers in order before giving up. Only transient errors trigger
# fallback (a 400 bad request is NOT retried). Comma-separated. Empty = off.
# Example: run Grok as primary, DeepSeek V4 Flash as a cheap backup.
# OPHELIA_FALLBACK_PROVIDERS=deepseek,xai-oauth
# OPHELIA_FALLBACK_MODEL=deepseek-flash   (optional: same model on every fallback)

# Optional per-role MODEL overrides (when unset, optional roles inherit chat)
# Ollama per-role:
# OLLAMA_CONSCIOUSNESS_MODEL=llama3.2:1b
# OLLAMA_CURATOR_MODEL=llama3.2:3b
# OLLAMA_VISION_MODEL=openbmb/minicpm-v4.6   (phone-friendly; or moondream)
# OLLAMA_IMAGE_MODEL=flux
# xAI per-role:
# XAI_CONSCIOUSNESS_MODEL=grok-3-mini
# XAI_CURATOR_MODEL=grok-3-mini
# XAI_VISION_MODEL=grok-4
# XAI_IMAGE_MODEL=grok-imagine-image
# XAI_VIDEO_MODEL=grok-imagine-video
# OpenAI per-role:
# OPENAI_CONSCIOUSNESS_MODEL=gpt-4o-mini
# OPENAI_CURATOR_MODEL=gpt-4o-mini
# OPENAI_VISION_MODEL=gpt-4o
# OPENAI_IMAGE_MODEL=dall-e-3
# DeepSeek per-role. deepseek-flash can see (vision auto-picks it when the key
# is set); deepseek-v4-pro can't. DeepSeek makes no images or video.
# DEEPSEEK_CONSCIOUSNESS_MODEL=deepseek-flash
# DEEPSEEK_CURATOR_MODEL=deepseek-flash
# DEEPSEEK_VISION_MODEL=deepseek-flash
# Compat per-role:
# OPHELIA_COMPAT_CONSCIOUSNESS_MODEL=local-small
# OPHELIA_COMPAT_CURATOR_MODEL=local-small
# OPHELIA_COMPAT_VISION_MODEL=local-vision

# --- Image generation backends (media-only; set OPHELIA_PROVIDER_IMAGE) ---
# Values: auto | ollama | xai-oauth | xai | openai |
#         pollinations | a1111 | comfyui | fal | replicate | civitai | modelslab
# xAI/OpenAI are CENSORED (refuse explicit prompts). The others are NSFW-capable.
# Pollinations is free and needs no key — image gen works with zero config.
# OPHELIA_PROVIDER_IMAGE=auto

# NSFW content tier. When true, the agent may write explicit prompts and they
# are auto-routed to an uncensored backend (NEVER xAI/OpenAI). When false,
# explicit image requests are refused. The generate_image tool takes an
# `nsfw` flag the model only sets when you explicitly ask for explicit content.
# OPHELIA_IMAGE_NSFW_ALLOWED=false
# OPHELIA_IMAGE_NSFW_PROVIDER=auto   # auto = first configured uncensored backend

# Pollinations (free, no key, lax on NSFW)
# POLLINATIONS_IMAGE_MODEL=flux

# Automatic1111 / SDWebUI (local, uncensored). Run with: --api --listen --port 7860
# A1111_BASE_URL=http://127.0.0.1:7860
# A1111_API_KEY=...            # only if --api-auth is set
# A1111_IMAGE_MODEL=sdxl       # optional checkpoint name
# A1111_STEPS=30
# A1111_SAMPLER=DPM++ 2M Karras
# A1111_CFG_SCALE=7.0

# ComfyUI (local, uncensored). Default txt2img graph; or export a workflow and
# point COMFYUI_WORKFLOW_PATH at it (supports {prompt}/{width}/{height}/{seed}/{model}).
# COMFYUI_BASE_URL=http://127.0.0.1:8188
# COMFYUI_IMAGE_MODEL=sdxl     # optional checkpoint filename
# COMFYUI_WORKFLOW_PATH=~/.ophelia/comfyui_workflow.json

# fal.ai (fast cloud; NSFW-tolerant flux/sdxl). https://fal.ai/dashboard/keys
# FAL_API_KEY=...
# FAL_IMAGE_MODEL=fal-ai/fast-sdxl   # or fal-ai/flux/dev, fal-ai/flux/schnell

# Replicate (cloud; many NSFW-allowed community models). https://replicate.com/account/api-tokens
# REPLICATE_API_KEY=...
# REPLICATE_IMAGE_MODEL=stability-ai/sdxl   # owner/model or owner/model:version

# Civitai Orchestration (NSFW checkpoints/LoRAs). https://civitai.com (API keys)
# CIVITAI_API_KEY=...
# CIVITAI_BASE_URL=https://orchestration.civitai.com
# For NSFW: OPHELIA_IMAGE_NSFW_ALLOWED=true and OPHELIA_IMAGE_NSFW_PROVIDER=civitai
# Normal images stay on OPHELIA_PROVIDER_IMAGE (Grok). Only explicit requests
# use Civitai, and only they pay with yellow Buzz.
# Auto mode picks per style (anime → WAI-Illustrious, pony/furry → Pony V6,
# photo → LUSTIFY) with each model's recommended steps/cfg/tags; she can also
# name a model (anima, zimage-turbo, qwen, flux1, ...) or pin any checkpoint.
# OPHELIA_CIVITAI_QUALITY=standard        # standard | high | max (more Buzz)
# OPHELIA_CIVITAI_DEFAULT_STYLE=anime     # when a prompt names no style
# OPHELIA_CIVITAI_CHECKPOINTS=            # anime=urn:air:...,realistic=urn:air:...
# OPHELIA_CIVITAI_MAX_COUNT=4             # images per request cap
# OPHELIA_CIVITAI_WAIT_SECONDS=180        # slower jobs are sent when finished
# OPHELIA_CIVITAI_PENDING_HOURS=6
# OPHELIA_IMAGE_MAX_ATTEMPTS=5            # cap when you tell her to keep trying
# CIVITAI_IMAGE_MODEL is no longer used (use OPHELIA_CIVITAI_CHECKPOINTS).
# Every Civitai image is logged to data/logs/image_generations.jsonl
# (model, LoRAs, prompt, seed, estimated + actual Buzz, file paths).
# Test it: ophelia civitai-test   (or --recipe lustify / --quality high)

# ModelsLab (hosted SD; explicit/adult models). https://modelslab.com/dashboard/api-keys
# MODELSLAB_API_KEY=...
# MODELSLAB_IMAGE_MODEL=flux
# MODELSLAB_BASE_URL=https://modelslab.com/api/v6

# --- Ollama (local — recommended) ---
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=llama3.2:3b
# Vision: phone-friendly options (Termux/S21U) — small + on-device, free:
#   openbmb/minicpm-v4.6  (1.3B, image+video, phone-optimized — recommended)
#   moondream            (1.9B, fast "what's in this photo")
#   openbmb/minicpm-v4   (4.1B, GPT-4V-class accuracy, heavier)
OLLAMA_VISION_MODEL=openbmb/minicpm-v4.6
# Auto-start `ollama serve` when Ophelia needs it and it's down.
# auto = on under Termux (where Ollama isn't a system service), off elsewhere.
# OPHELIA_OLLAMA_AUTOSTART=true
# How long Ollama keeps a model in memory after each call. The default 5m is
# too short for vision: photos are rare, so the model unloads between them and
# every photo cold-loads ~1GB from flash (a 10-25s stall on a phone). 30m keeps
# it warm between uses; -1 keeps it loaded forever (more RAM, fastest).
# OPHELIA_OLLAMA_KEEP_ALIVE=30m
# Ollama's context window defaults to 4096 tokens and silently drops the START
# of longer prompts (her system prompt + SOUL). Her full prompt is ~4-9k
# tokens. If you see `ollama.prompt_truncated` in the logs, start ollama with
# OLLAMA_CONTEXT_LENGTH=8192 — or set this when Ophelia auto-starts Ollama
# (Termux). More context = more RAM (~0.5 GB at 8192 for 1B, ~1 GB for 3B).
# OPHELIA_OLLAMA_NUM_CTX=8192
# Semantic memory recall (optional — keyword recall always works without it).
# auto = on only on PC/server AND only if the model is already pulled
#        (`ollama pull nomic-embed-text`); stays off on Termux so the phone
#        never loads a second model. on = force it (Termux too). off = never.
# OPHELIA_EMBEDDINGS=auto
# OPHELIA_EMBED_MODEL=nomic-embed-text
# Tool tiers: send only core + relevant tool groups per turn (~7 KB instead of
# ~35 KB of tool schemas) — faster prompt processing, better tool picks on
# small models. She can pull in any group with load_tools.
# auto = only when chat runs on local Ollama; on = always; off = every tool.
# OPHELIA_TOOL_TIERS=auto
# Daily diary: one short curator-model call per day writes "yesterday, in her
# words" into her prompt. Turn off to avoid that daily call.
# OPHELIA_DIARY=true
# Personality integrity. She grows by LEARNING (evolve_self → ~/.ophelia/GROWTH.md,
# shown right after her SOUL); her core SOUL.md / PROMPTER.md change only when
# the owner asks in chat (owner), never via tools (on), or whenever (off).
# OPHELIA_PERSONA_LOCK=owner
# Strip AI tells from text replies: em/en dashes, [bracketed narration],
# [pause:…] voice markup. Voice replies keep them (they shape speech).
# OPHELIA_HUMANIZE_TEXT=true
# Backups of who she is (SOUL, growth, memories, databases…) — daily, keeping 7.
# On Termux they go to phone storage (~/storage/shared/Ophelia/backups; run
# `termux-setup-storage` once) so they survive clearing/uninstalling Termux.
# To survive losing the PHONE, set OPHELIA_BACKUP_OFFSITE=owner: she DMs you the
# archive on Telegram/Discord weekly (Telegram ≤50 MB, Discord ≤10 MB). Note it
# contains your chat history; secrets (.env, tokens) are left out unless
# OPHELIA_BACKUP_INCLUDE_SECRETS=true.
# Storage housekeeping (daily). Vision screen captures (data/screenshots/
# screen_*) older than this are deleted; 0 = keep forever.
# OPHELIA_SCREENSHOT_KEEP_HOURS=24
# Chat-log media copies (data/logs/media) older than N days are deleted;
# 0 (default) = keep forever. Preview with `ophelia cleanup --dry-run`.
# OPHELIA_CHAT_LOG_MEDIA_DAYS=0
# OPHELIA_BACKUP=true
# OPHELIA_BACKUP_DIR=
# OPHELIA_BACKUP_INTERVAL_HOURS=24
# OPHELIA_BACKUP_KEEP=7
# OPHELIA_BACKUP_OFFSITE=none
# OPHELIA_BACKUP_OFFSITE_DAYS=7
# Chat sampling temperature (unset = provider default). DeepSeek's default is
# 1.0; its docs suggest 1.3 for conversation — livelier, less assistant-flat.
# OPHELIA_CHAT_TEMPERATURE=1.3

# --- xAI / SuperGrok OAuth (optional cloud fallback) ---
# ophelia auth import-hermes  OR  ophelia auth import-grok
# OPHELIA_PROVIDER=xai-oauth     (SuperGrok OAuth token)
# OPHELIA_PROVIDER=xai           (API key only — does NOT fall back to OAuth,
#                                 because OAuth is a different tier that may
#                                 not access the same models)
# XAI_API_KEY=xai-...
# Aliases (drop in a working config from another Grok bot, e.g. Discord):
#   GROK_API_KEY = XAI_API_KEY
#   GROK_API_URL = XAI_BASE_URL
#   GROK_MODEL   = XAI_MODEL
XAI_MODEL=grok-4
XAI_BASE_URL=https://api.x.ai/v1

# --- OpenAI / compat ---
# OPENAI_API_KEY=sk-...
# OPHELIA_COMPAT_API_KEY=...
# OPHELIA_COMPAT_BASE_URL=http://127.0.0.1:1234/v1
# OPHELIA_COMPAT_MODEL=your-model

# --- DeepSeek (very cheap cloud — great for background roles / fallback) ---
# OpenAI-compatible. Get a key at https://platform.deepseek.com
# deepseek-flash:  V4.1 Flash, cheapest, takes images (1M-token context)
# deepseek-v4-pro: more capable, higher cost, text only
# (deepseek-chat / deepseek-reasoner were retired on 2026-07-24)
# OPHELIA_PROVIDER=deepseek
# DEEPSEEK_API_KEY=ds-...
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# DEEPSEEK_MODEL=deepseek-flash
# Enable DeepSeek V4 thinking mode (returns reasoning_content). Off by default
# because thinking mode often reasons past tool calls — e.g. the model decides
# during reasoning that it "can't search the web" and never calls web_search.
# OPHELIA_DEEPSEEK_THINKING=false

# --- Chat channels (enable one or both) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=
# Hermes uses TELEGRAM_ALLOWED_USERS — Ophelia accepts either name
# OPHELIA_TELEGRAM_ENABLED=true

DISCORD_BOT_TOKEN=
DISCORD_ALLOWED_USER_IDS=
# OPHELIA_DISCORD_ENABLED=true
#
# Discord logging server — Ophelia auto-creates categories + channels here:
#   Main (activity, consciousness, inner-thoughts, system)
#   Telegram (one channel per Telegram chat)
#   DMs (one channel per Discord DM partner)
#   Discord Servers (one channel per server she joins)
# Right-click your logging server icon → Copy Server ID (Developer Mode on).
# DISCORD_GUILD_ID=
# OPHELIA_DISCORD_LOG=true   # default on when DISCORD_GUILD_ID is set
# Bot needs Manage Channels + Send Messages + Attach Files in that server.
# OPHELIA_PRIMARY_CHANNEL=telegram:123456789
# Consciousness outreach goes to all configured channels.

# --- Owner vs guests (multi-user sandboxing) ---
# The ONE user whose conversations shape her memory/personality/soul/evolution.
# Everyone else who messages her is a sandboxed guest: she talks to them with
# her full personality, but the conversation never touches her identity (no
# lessons, no memory writes, no soul/drive/goal changes, no private inner
# thoughts revealed). Channel-style, comma-separated for multiple:
#   OPHELIA_OWNER_ID=telegram:123456789
#   OPHELIA_OWNER_ID=telegram:111,discord:222
# To let others message her, add their IDs to TELEGRAM/DISCORD_ALLOWED_USER_IDS
# above — anyone in that list who isn't the owner becomes a guest. If unset,
# the first allowed user is treated as the owner (backward compatible).
#
# Don't know a friend's user ID? You don't have to. Set admission to "approve"
# (the default) and when a stranger messages her, she asks YOU to approve them:
#   - Telegram: you get an Accept / Decline button. Tap Accept and she adds
#     their ID to the allowlist automatically — no copy/pasting IDs.
#   - Discord: you get a DM; reply with `!approve <id>` or `!deny <id>`.
# Values: approve (default) | open (anyone chats as a guest, no prompt) |
#         reject (refuse strangers outright)
# OPHELIA_GUEST_ADMISSION=approve
# OPHELIA_OWNER_ID=

# Universal chat log (oversight): every message + media sent to/from her is
# recorded in ~/.ophelia/data/logs/ (SQLite index + organized media folder).
# View with: ophelia logs [--channel telegram:ID] [--media] [--since YYYY-MM-DD]
# OPHELIA_CHAT_LOG=true

# --- PC ↔ optional phone body (NOT required on PC/server/VPS) ---
# Default: OPHELIA_ANDROID_ENABLED=false — brain-only Ophelia is fully valid.
# On phone-as-host (Termux): Shizuku — auto-enabled if configured
# From PC/server → separate phone: set ADB target below
# OPHELIA_ANDROID_ENABLED=true
# OPHELIA_ADB_DEVICE=192.168.1.50:5555
# OPHELIA_ADB_ROOT=false

# --- PC vs phone auto-detect overrides ---
# OPHELIA_GAMES=false
# OPHELIA_LISTEN=false

# --- Workstation UI (ophelia ui) ---
OPHELIA_UI_HOST=127.0.0.1
OPHELIA_UI_PORT=8765
OPHELIA_UI_OPEN_BROWSER=true
# VTuber / Live2D / VRoid / VRChat stage (procedural by default)
OPHELIA_AVATAR_ENABLED=true
# OPHELIA_AVATAR_DIR=~/.ophelia/avatar
# OPHELIA_AVATAR_MODEL=model.fbx            # .fbx (VRChat) | .vrm | .glb/.gltf | .model3.json
# OPHELIA_AVATAR_BACKEND=auto               # auto | procedural | live2d | vroid | vrchat

# --- Public wiki/blog (ophelia site) ---
# Local reader also starts with `ophelia run` on :8788.
OPHELIA_SITE_ENABLED=true
# OPHELIA_SITE_HOST=127.0.0.1
# OPHELIA_SITE_PORT=8788
# Your custom domain (Cloudflare Pages). She quotes this; deploy pushes HTML there.
# OPHELIA_SITE_PUBLIC_URL=https://your-domain.com
# Cloudflare Direct Upload — Create API Token with Account → Cloudflare Pages → Edit
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=          # dashboard overview / right sidebar
# OPHELIA_SITE_CF_PROJECT=        # Pages project name (the one attached to your domain)
# OPHELIA_SITE_CF_BRANCH=main
# OPHELIA_SITE_CF_CREATE_PROJECT=false
# Optional: pip install blake3   (or install wrangler) for site_deploy / `ophelia site deploy`

# --- Web + MCP ---
# Grok has built-in live search; DeepSeek/OpenAI/Ollama do NOT — so when running
# on those providers Ophelia uses the web_search tool. Pick a backend:
#   auto         first API key set below, else DeepSeek (if DEEPSEEK_API_KEY),
#                else DuckDuckGo (default)
#   deepseek     DeepSeek Search/Fetch API with your DeepSeek key (~$0.75/1k)
#   duckduckgo   free, no key, less reliable (often returns nothing)
#   tavily       AI-focused, reliable (free tier at https://tavily.com)
#   serper       Google results, reliable (https://serper.dev)
#   brave        Brave Search API (https://brave.com/search/api/)
OPHELIA_WEB_SEARCH=true
OPHELIA_WEB_SEARCH_PROVIDER=auto
# TAVILY_API_KEY=tvly-...
# SERPER_API_KEY=...
# BRAVE_API_KEY=...
# OPHELIA_MCP_CONFIG=~/.ophelia/mcp.json  (see mcp.example.json)

# Consciousness / aliveness
OPHELIA_CONSCIOUSNESS=true
OPHELIA_CONSCIOUSNESS_INTERVAL=60     # seconds between ticks (lower = more alive)
OPHELIA_TICK_ACTION_COOLDOWN=300      # after she acts/outreaches, skip ticks for N s (0=off)
OPHELIA_TICK_IDLE_NUDGE_ROTATE=true   # vary idle nudge mode (reflect/create/explore/social)
OPHELIA_INITIATIVE_THRESHOLD=0.50     # lower = messages you sooner
OPHELIA_GREET_ON_START=true           # proactive hello when she boots
OPHELIA_MAX_SPONTANEOUS_PER_HOUR=4    # raise for more outreach
# OPHELIA_QUIET_HOURS=23-08           # no outreach 11pm-8am

# Agentic tool loop (per turn)
OPHELIA_MAX_TOOL_ROUNDS=25            # hard cap on tool-call rounds before bailing
OPHELIA_TOOL_LOOP_RESUME=true         # resume unfinished tool chains next turn (unless stuck)
OPHELIA_HUMAN_PACING=true             # typing time ~ reply length; sleepy when you wake her
OPHELIA_QUIET_MAX_MINUTES=30          # cap on her silent treatment (go_quiet)
OPHELIA_INTERJECTIONS=parallel        # messages mid-task: parallel (reply while she keeps
                                      # going) | pause (answer between steps) | off
# Raise the cap (e.g. 40) if she's building long artifacts like a from-scratch
# synth engine; the "Continue" button in Telegram lets you extend a capped turn
# with one tap.

# Phone body
OPHELIA_ANDROID_ENABLED=true
OPHELIA_VISION_ENABLED=true
# Draw a native-pixel coordinate grid on screenshots sent to vision so tap
# coordinates come back in `input tap`'s native space (not the model's resized
# image space). Calibrate with: ophelia phone calibrate
OPHELIA_VISION_GRID=true

# Tier 2
OPHELIA_INNER_LOG=true
OPHELIA_INNER_MIRROR_TELEGRAM=false
OPHELIA_LISTEN=false
OPHELIA_CURATOR=true
OPHELIA_CURATOR_HOURS=6

# Dream / consolidation (offline self-reflection that extracts lessons)
OPHELIA_DREAM=true
OPHELIA_DREAM_HOURS=4

# Games
OPHELIA_GAMES=true
OPHELIA_GAME_SESSION_MINUTES=15
OPHELIA_GAME_MAX_TURNS=40

# HONCHO_API_KEY=
# OPHELIA_VOICE_REPLY=false

# --- Life context (time / schedule / presence) ---
# Phone is stationary at home — infer owner state from schedule + Telegram activity
# Clock: IANA name (America/New_York), abbrev (EST), or "system" for host local time.
# Default is system. Chat "switch to EST" persists via the set_timezone tool.
# OPHELIA_TIMEZONE=system
# OPHELIA_TIMEZONE=America/New_York
# OPHELIA_WORK_DAYS=Thu,Wed,Tue,Fri
# OPHELIA_WORK_HOURS=18-06
# OPHELIA_SLEEP_HOURS=1-7
#   Your sleep hours. Her body clock follows them: she goes to bed an hour
#   after you and wakes when you do (default 1-8 if unset). Tired late,
#   asleep at night (no thinking calls), woken by your messages.
# OPHELIA_BODY_CLOCK=true
# OPHELIA_SLEEP_MODE=true
# OPHELIA_HOME_WIFI_SSID=

# --- Autonomous presence (Neuro-style) ---
# OPHELIA_WAKE_WORD=true
# OPHELIA_WAKE_WORD_NAME=ophelia
# OPHELIA_WAKE_RMS=200
# OPHELIA_SPONTANEOUS_VOICE=true
# OPHELIA_AMBIENT_COMMENTARY=true
# OPHELIA_AMBIENT_COMMENTARY_MINUTES=45
# OPHELIA_ALARMS=06:30
# OPHELIA_AUTO_GAME_BOREDOM=0.85
# OPHELIA_PROACTIVE_SHARE=true

# --- Voice / TTS ---
# Backend for voice replies + the text_to_speech tool:
#   auto (default) = first configured of elevenlabs -> kokoro -> openai -> xai
#   elevenlabs = cloud, best quality (free tier ~10k chars/month)
#   kokoro     = Kokoro-82M via a LOCAL OpenAI-compatible server — fully offline
#   openai     = gpt-4o-mini-tts (uses OPENAI_API_KEY)
#   xai        = Grok TTS (legacy default; voices: eve, ara, rex)
# OPHELIA_TTS_PROVIDER=auto
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
# KOKORO_TTS_URL=http://127.0.0.1:8880/v1
# Prefer a single preset. For custom blends, bake with L2 renorm:
#   ophelia tts combine "af_heart(0.45)+af_bella(0.35)+bf_emma(0.2)"
# then set KOKORO_TTS_VOICE to the baked name (ophelia_mix_…).
# Raw inline mixes from Kokoro-FastAPI skip L2 renorm → muffled/peaky audio.
# KOKORO_TTS_VOICE=af_heart
# KOKORO_VOICES_DIR=/path/to/kokoro-fastapi/api/src/voices/v1.0
# KOKORO_TTS_SPEED=1.0
# Auto-start `koko openai` when Kokoro TTS is configured and the server is down.
# auto = on under Termux (where Kokoros usually runs in proot), off elsewhere.
# OPHELIA_KOKORO_AUTOSTART=true
# Optional overrides if autodetect fails (proot Ubuntu — add ONE of these to ~/.ophelia/.env):
# KOKORO_AUTOSTART_CMD=proot-distro login ubuntu -- bash -lc 'cd /root/Kokoros && ./target/release/koko openai --port 8880'
# KOKORO_LISTEN_PORT=8880
# KOKORO_KOKO_BIN=/data/data/com.termux/files/usr/var/lib/proot-distro/installed-rootfs/ubuntu/root/Kokoros/target/release/koko
# KOKORO_KOKO_CWD=/data/data/com.termux/files/usr/var/lib/proot-distro/installed-rootfs/ubuntu/root/Kokoros
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# OPENAI_TTS_VOICE=nova
# XAI_TTS_VOICE=eve

