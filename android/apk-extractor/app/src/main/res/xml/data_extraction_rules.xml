<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing worth backing up: the only state is the chosen output folder. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
